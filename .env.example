APP_NAME=Healthcare AI Voice Agent
APP_ENV=development

# LLM_MODE=demo keeps the app deterministic and offline.
# Set LLM_MODE=live and provide a valid key to enable the provider-backed path.
LLM_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20

# CALCOM_MODE=demo returns a synthetic booking.
# Set CALCOM_MODE=live only after configuring a Cal.com API key and event type.
CALCOM_MODE=demo
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_BASE_URL=https://api.cal.com
CALCOM_API_VERSION=2026-02-25
CALCOM_TIMEOUT_SECONDS=20

CORS_ORIGINS=http://localhost:5173
