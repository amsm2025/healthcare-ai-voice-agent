APP_NAME=Healthcare AI Voice Agent
APP_ENV=development

# LLM_MODE=demo keeps the app deterministic and offline.
# Set LLM_MODE=live and provide a valid key to enable the provider-backed path.
LLM_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20

CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_BASE_URL=https://api.cal.com

CORS_ORIGINS=http://localhost:5173
